<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <!-- ========================================================= -->
    <!-- 1. Create table: product_catalog_details -->
    <!-- ========================================================= -->
    <changeSet id="1-create-product-catalog-details" author="ayush">
        <createTable tableName="product_catalog_details">
            <column name="catalog_id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="catalog_name" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="parent_catalog_id" type="BIGINT"/>
            <column name="description" type="TEXT"/>
            <column name="status" type="VARCHAR(20)" defaultValue="ACTIVE"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="product_catalog_details"
                baseColumnNames="parent_catalog_id"
                referencedTableName="product_catalog_details"
                referencedColumnNames="catalog_id"
                constraintName="fk_parent_catalog"/>

        <createIndex tableName="product_catalog_details" indexName="idx_catalog_name">
            <column name="catalog_name"/>
        </createIndex>
    </changeSet>

    <!-- ========================================================= -->
    <!-- 2. Create table: product_details -->
    <!-- ========================================================= -->
    <changeSet id="2-create-product-details" author="ayush">
        <createTable tableName="product_details">
            <column name="product_id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="product_name" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="sku" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="maker_name" type="VARCHAR(100)"/>
            <column name="model_number" type="VARCHAR(100)"/>
            <column name="price" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="in_stock" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="discount_percent" type="DECIMAL(5,2)" defaultValueNumeric="0"/>
            <column name="quantity_in_stock" type="INT" defaultValueNumeric="0"/>
            <column name="weight" type="DECIMAL(6,2)"/>
            <column name="dimensions" type="VARCHAR(100)"/>
            <column name="status" type="VARCHAR(20)" defaultValue="ACTIVE"/>
            <column name="catalog_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="product_details"
                baseColumnNames="catalog_id"
                referencedTableName="product_catalog_details"
                referencedColumnNames="catalog_id"
                onDelete="CASCADE"
                constraintName="fk_product_catalog"/>

        <createIndex tableName="product_details" indexName="idx_product_name">
            <column name="product_name"/>
        </createIndex>

        <createIndex tableName="product_details" indexName="idx_sku">
            <column name="sku"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>