<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="false">

    <!-- Spring properties -->
    <springProperty name="APP_NAME" source="spring.application.name" defaultValue="application"/>

    <springProperty name="PROFILE" source="spring.profiles.active" defaultValue="DEV"/>

    <!-- Startup timestamp -->
    <timestamp key="START_TIME" datePattern="yyyyMMdd-HHmmss"/>

    <!-- Logs outside src -->
    <property name="LOG_PATH" value="./logs"/>

    <!-- Console appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ================= DEV ================= -->
    <springProfile name="DEV">

        <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <!-- One file per app startup -->
            <file>./logs/eshop-manager-DEV-${START_TIME}.log</file>

            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <!-- MUST contain %d -->
                <fileNamePattern>
                    ./logs/eshop-manager-DEV-${START_TIME}.%d{yyyy-MM-dd}.%i.log
                </fileNamePattern>

                <maxFileSize>10MB</maxFileSize>
                <maxHistory>10</maxHistory>
            </rollingPolicy>

            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>

        <root level="DEBUG">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>

    </springProfile>

    <!-- ================= UAT / PROD ================= -->
    <springProfile name="UAT,PROD">

        <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>./logs/eshop-manager-${PROFILE}-${START_TIME}.log</file>

            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>
                    ./logs/eshop-manager-${PROFILE}-${START_TIME}.%d{yyyy-MM-dd}.%i.log
                </fileNamePattern>

                <maxFileSize>5MB</maxFileSize>
                <maxHistory>20</maxHistory>
            </rollingPolicy>

            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>

    </springProfile>

    <!-- ================= FALLBACK ================= -->
    <springProfile name="default">

        <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_PATH}/${APP_NAME}-DEFAULT-${START_TIME}.log</file>

            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>
                    ${LOG_PATH}/${APP_NAME}-DEFAULT-${START_TIME}.%i.log
                </fileNamePattern>
                <maxFileSize>10MB</maxFileSize>
                <maxHistory>5</maxHistory>
            </rollingPolicy>

            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>

    </springProfile>

</configuration>